# DeskBooker local development. Copy to .env; never commit real secrets.
# Use 5433 when host port 5432 is already taken.
POSTGRES_PASSWORD=replace-with-your-own-local-password
POSTGRES_PORT=5433

# Allowed browser origins. Multiple comma-separated origins are supported.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional backend overrides:
# PORT=8080
# POSTGRES_HOST=localhost
# POSTGRES_USER=deskbooker
# POSTGRES_DB=deskbooker
# POSTGRES_SSLMODE=disable
# DATABASE_URL=postgres://deskbooker:password@localhost:5433/deskbooker?sslmode=disable

# Registration allowlist. Replace example.com with your company email domain.
# When unset, POST /api/auth/register returns HTTP 503 (fail closed).
REGISTRATION_EMAIL_DOMAIN=example.com
