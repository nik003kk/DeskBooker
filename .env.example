# DeskBooker local development. Copy to .env; never commit real secrets.
# Use 5433 when host port 5432 is already taken.
POSTGRES_PASSWORD=replace-with-your-own-local-password
POSTGRES_PORT=5433

# Optional backend overrides:
# PORT=8080
# POSTGRES_HOST=localhost
# POSTGRES_USER=deskbooker
# POSTGRES_DB=deskbooker
# POSTGRES_SSLMODE=disable
# DATABASE_URL=postgres://deskbooker:password@localhost:5433/deskbooker?sslmode=disable
