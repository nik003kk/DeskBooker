# Public browser-side configuration only (never add passwords or API secrets).
# Reserved for the later frontend-to-backend integration.
VITE_API_BASE_URL=http://localhost:8080/api

# Client-side hint/validation. Match backend root .env REGISTRATION_EMAIL_DOMAIN.
# For local testing you may set both to gmail.com. Backend always revalidates.
VITE_REGISTRATION_EMAIL_DOMAIN=gmail.com
