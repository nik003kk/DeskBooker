# HTTP API port
PORT=8080

# Local PostgreSQL connection (matches root Docker Compose .env)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=deskbooker
POSTGRES_DB=deskbooker
POSTGRES_PASSWORD=replace-with-password-from-root-env
POSTGRES_SSLMODE=disable

# Alternative: DATABASE_URL overrides all POSTGRES_* variables.
# DATABASE_URL=postgres://deskbooker:password@localhost:5433/deskbooker?sslmode=disable
