# Reference for backend environment settings.
# For local development use ../.env (repository root) instead.
# Do not copy credentials into Git or expose them via frontend VITE_* variables.
PORT=8080
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=deskbooker
POSTGRES_DB=deskbooker
POSTGRES_PASSWORD=replace-with-password-from-root-env
POSTGRES_SSLMODE=disable

# Optional DATABASE_URL takes precedence over POSTGRES_* values.

# Company email suffix permitted on POST /api/auth/register.
# Set the real domain in the root .env, not here.
REGISTRATION_EMAIL_DOMAIN=example.com
